# OpenRouter (Priority #1)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Groq (Priority #2)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM (Priority #3)
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ATS Resume Analyzer API (ats.onl9.club) — anonymous calls accepted
ATS_API_BASE_URL=https://ats-api.onl9.club/api/v1

# Notion Integration (Sync completed applications, upload CV & CL PDFs)
# 1. Create integration token at https://www.notion.so/profile/integrations
# 2. Connect integration to database (Open database -> "..." -> Connect to -> select your integration)
# NOTION_API_KEY=ntn_your_notion_integration_token_here
# NOTION_DATABASE_ID=26d086ddaa064aa0b51318c8d3e6a84f
# NOTION_VERSION=2026-03-11
# Delete CVs, CLs, and workflow files in /output after uploading to Notion (default: true)
CLEANUP_OUTPUT_AFTER_NOTION_SYNC=true

# Dynamic Portfolio Sync & Ingestion (portfolio.onl9.club)
PORTFOLIO_URL=https://portfolio.onl9.club
SYNC_PORTFOLIO_ON_RUN=true
PORTFOLIO_CACHE_HOURS=24

# Form autofill (semi-auto apply) — OFF by default
# When AUTO_APPLY=true, after the CV/CL PDFs pass their layout gates the pipeline opens a
# VISIBLE browser at the job posting, pre-fills the application form from
# candidate_profile.json, attaches the generated PDFs, then STOPS for human review.
# It NEVER clicks Submit (see AUTO_SUBMIT below) and never touches EEO/diversity,
# consent, or account-creation fields — those are logged and left for the human.
AUTO_APPLY=false
AUTO_SUBMIT=false            # NEVER enable casually — submits without human review
AUTOFILL_LOGIN_WAIT_SECONDS=180
# How long to keep the browser open for review after filling (seconds; 0 = close immediately)
AUTOFILL_REVIEW_WAIT_SECONDS=300
